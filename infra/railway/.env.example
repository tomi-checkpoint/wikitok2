# WikiTok Supabase Infrastructure
# Copy this file to .env and fill in values from your Railway deployment

# Supabase API (Kong public domain)
SUPABASE_URL=https://your-kong-domain.up.railway.app
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Postgres connection (for migrations)
POSTGRES_URL=postgresql://postgres:password@host:5432/supabase

# PgBouncer pooled connection (for app runtime)
PGBOUNCER_URL=postgresql://postgres:password@host:6543/supabase

# JWT Secret (from Railway Kong service)
JWT_SECRET=your-jwt-secret-here
